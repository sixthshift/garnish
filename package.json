{
  "name": "garnish",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite dev --host",
    "build": "NODE_ENV=production bun --bun vite build",
    "start": "bun run .output/server/index.mjs",
    "check": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun --bun vitest run",
    "migrate": "bun run src/db/migrations/migrate.ts",
    "seed": "bun run src/db/seed/cli.ts",
    "dev:seed": "bun run src/db/dev/cli.ts",
    "db:generate": "drizzle-kit generate",
    "backup": "bun run src/db/backup/cli.ts",
    "restyle": "bun run src/server/ai/restyleLabCli.ts",
    "propose": "bun run src/server/ai/plannerLabCli.ts",
    "icons": "bun run scripts/icons.tsx",
    "version:next": "bun run scripts/version.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@sixthshift/design-system": "^0.6.0",
    "@tanstack/react-router": "^1.170.36",
    "@tanstack/react-start": "^1.168.54",
    "drizzle-orm": "^0.45.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/start-storage-context": "^1.167.32",
    "@tanstack/virtual-file-routes": "1.162.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "happy-dom": "^20.9.0",
    "nitro": "^3.0.260903-beta",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
